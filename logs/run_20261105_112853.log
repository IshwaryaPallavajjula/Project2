Code:
    def roman_to_int(s: str) -> int:
        """
        Convert a Roman numeral string to an integer.
        Supports standard Roman numerals up to 3999.
        """
        roman_map = {
            'I': 1,
            'V': 5,
            'X': 10,
            'L': 50,
            'C': 100,
            'D': 500,
            'M': 1000,
        }
        total = 0
        prev_value = 0
        for char in reversed(s.upper()):
            value = roman_map.get(char, 0)
            if value < prev_value:
                total -= value
            else:
                total += value
                prev_value = value
        return total

